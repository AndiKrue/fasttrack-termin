# Copy to .env (git-ignored) and fill in. Never commit .env.
NVIDIA_API_KEY=
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=

# Zetaris Lightning (leave ZETARIS_JDBC_JAR empty to use the local SQLite stand-in)
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
# Host runs: full path to the driver jar. Compose ignores this and mounts ZETARIS_JDBC_DIR instead.
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_DIR=C:/Tools/zetaris-platform/jdbc

# Optional
# Google Maps Embed API key (restrict it to the Maps Embed API and the referrers 127.0.0.1:8765 and
# *.trycloudflare.com). Empty: route cards show only the OSM/Google route links, no embedded map.
GOOGLE_MAPS_EMBED_KEY=
# FT_MINIAPP_URL=https://<your-host>.trycloudflare.com/miniapp   (compose finds the tunnel URL itself)
# FT_MEMORY=local
